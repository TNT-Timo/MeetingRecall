<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeetingRecall.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MeetingRecall">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="18,0,140,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE8D4;" FontSize="15" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="MeetingRecall" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <AutoSuggestBox
                x:Name="ConversationSearchBox"
                Grid.Column="2"
                Width="320"
                Margin="16,0,10,0"
                VerticalAlignment="Center"
                PlaceholderText="Gespräche durchsuchen"
                TextChanged="ConversationSearchBox_TextChanged"
                AutomationProperties.Name="Gespräche durchsuchen">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <Border
                Grid.Column="3"
                Margin="0,7,10,7"
                Padding="6,0"
                CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton
                        x:Name="ExactSearchModeButton"
                        Content="Exakt"
                        GroupName="SearchMode"
                        Click="SearchModeButton_Click"
                        VerticalAlignment="Center" />
                    <RadioButton
                        x:Name="ContentSearchModeButton"
                        Content="Inhaltlich"
                        GroupName="SearchMode"
                        IsChecked="True"
                        Click="SearchModeButton_Click"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button
                Grid.Column="4"
                Width="36"
                Height="36"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                ToolTipService.ToolTip="Einstellungen">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid Padding="14,16,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="8">
                        <Button
                            x:Name="RecordingButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="14,11"
                            CornerRadius="10"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Click="RecordingButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE720;" FontSize="16" />
                                <TextBlock Text="Neue Aufnahme" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ImportButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="14,11"
                            CornerRadius="10"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Click="ImportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                <TextBlock Text="Datei importieren" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ConversationListHeadingText" Text="ALLE GESPRÄCHE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="ConversationSortButton"
                            Grid.Column="1"
                            Width="26"
                            Height="24"
                            Margin="0,-5,4,-3"
                            Padding="0"
                            Background="Transparent"
                            ToolTipService.ToolTip="Gespräche sortieren: zuletzt geändert"
                            AutomationProperties.Name="Gespräche sortieren">
                            <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <RadioMenuFlyoutItem
                                        Text="Zuletzt geändert"
                                        GroupName="ConversationSort"
                                        Tag="UpdatedDescending"
                                        IsChecked="True"
                                        Click="ConversationSortMenuItem_Click" />
                                    <RadioMenuFlyoutItem
                                        Text="Älteste Änderung"
                                        GroupName="ConversationSort"
                                        Tag="UpdatedAscending"
                                        Click="ConversationSortMenuItem_Click" />
                                    <RadioMenuFlyoutItem
                                        Text="Name A–Z"
                                        GroupName="ConversationSort"
                                        Tag="NameAscending"
                                        Click="ConversationSortMenuItem_Click" />
                                    <RadioMenuFlyoutItem
                                        Text="Name Z–A"
                                        GroupName="ConversationSort"
                                        Tag="NameDescending"
                                        Click="ConversationSortMenuItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock x:Name="ArchiveCountText" Grid.Column="2" Text="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView
                        x:Name="ConversationsList"
                        Grid.Row="3"
                        SelectionMode="Single"
                        SelectionChanged="ConversationsList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="CornerRadius" Value="9" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,9">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="{Binding PrimaryContextAction}"
                                                Tag="{Binding}"
                                                Click="RenameConversationMenuItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Text="{Binding DestructiveContextAction}"
                                                Tag="{Binding}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Click="DeleteConversationMenuItem_Click"
                                                ToolTipService.ToolTip="Endgültig löschen – Bestätigung erforderlich">
                                                <MenuFlyoutItem.Icon>
                                                    <SymbolIcon Symbol="Delete" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,3,0,0"
                                        Text="{Binding Metadata}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid
                x:Name="ConversationPane"
                Grid.Column="2"
                Padding="34,26,34,18"
                Background="Transparent"
                PointerWheelChanged="ConversationPane_PointerWheelChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="ProcessingQueueButton"
                        Grid.Column="0"
                        Content="Warteschlange · 0"
                        MinWidth="132"
                        Height="32"
                        Padding="11,5"
                        VerticalAlignment="Center"
                        CornerRadius="8"
                        Opacity="0.62"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="0 Aufträge in der Warteschlange"
                        Click="ProcessingQueueButton_Click"
                        AutomationProperties.Name="Verarbeitungswarteschlange öffnen" />

                    <TextBlock
                        x:Name="ConversationPaneHeadingText"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        FontSize="26"
                        FontWeight="SemiBold" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <ProgressRing x:Name="BusyIndicator" Width="18" Height="18" IsActive="False" />
                        <TextBlock
                            x:Name="StatusText"
                            MaxWidth="520"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="CancelOperationButton"
                            Content="Abbrechen"
                            Padding="10,5"
                            Visibility="Collapsed"
                            Click="CancelOperationButton_Click"
                            AutomationProperties.Name="Laufenden Vorgang abbrechen" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Border
                        x:Name="EmptyState"
                        MaxWidth="650"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                            <Border Width="64" Height="64" CornerRadius="18" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE8D4;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyStateTitleText" Text="Deine lokalen Gespräche" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock
                                    x:Name="EmptyStateDescriptionText"
                                    MaxWidth="500"
                                    Text="Importiere eine Audio- oder Videodatei. Videos werden nicht gespeichert; MeetingRecall extrahiert ausschließlich eine MP3-Audiospur."
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                x:Name="EmptyStateImportButton"
                                Padding="16,9"
                                CornerRadius="9"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Click="ImportButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Datei importieren" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer
                        x:Name="ConversationDetail"
                        HorizontalAnchorRatio="0.5"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        Visibility="Collapsed">
                        <Grid
                            x:Name="ConversationDetailViewport"
                            HorizontalAlignment="Stretch">
                            <StackPanel
                                x:Name="ConversationDetailContent"
                                MaxWidth="920"
                                HorizontalAlignment="Stretch"
                                Spacing="18">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="ConversationTitleText" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ConversationMetadataText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Border
                                    Padding="20"
                                    CornerRadius="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Audio" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="AudioFileNameText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button
                                                    x:Name="DownloadAudioButton"
                                                    Width="36"
                                                    Height="36"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    IsEnabled="False"
                                                    Click="DownloadAudioButton_Click"
                                                    ToolTipService.ToolTip="Audiodatei speichern"
                                                    AutomationProperties.Name="Audiodatei unter dem aktuellen Gesprächsnamen speichern">
                                                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                                                </Button>
                                                <TextBlock Text="Tempo" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ComboBox x:Name="PlaybackRateComboBox" Width="90" SelectedIndex="1" SelectionChanged="PlaybackRateComboBox_SelectionChanged">
                                                    <ComboBoxItem Content="0,75×" Tag="0.75" />
                                                    <ComboBoxItem Content="1×" Tag="1" />
                                                    <ComboBoxItem Content="1,25×" Tag="1.25" />
                                                    <ComboBoxItem Content="1,5×" Tag="1.5" />
                                                    <ComboBoxItem Content="2×" Tag="2" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <Grid
                                                x:Name="TimelineTrack"
                                                Height="36"
                                                Background="Transparent"
                                                PointerPressed="TimelineTrack_PointerPressed"
                                                PointerMoved="TimelineTrack_PointerMoved"
                                                PointerReleased="TimelineTrack_PointerReleased"
                                                SizeChanged="TimelineTrack_SizeChanged"
                                                AutomationProperties.Name="Wiedergabeposition">
                                                <Border
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                                                <Border
                                                    x:Name="TimelineProgress"
                                                    Width="0"
                                                    Height="8"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Ellipse
                                                    x:Name="TimelineThumb"
                                                    Width="16"
                                                    Height="16"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    StrokeThickness="3" />
                                            </Grid>

                                            <Grid Margin="2,-2,2,0">
                                                <TextBlock
                                                    x:Name="CurrentTimeText"
                                                    Text="00:00"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    x:Name="TotalTimeText"
                                                    Text="00:00"
                                                    HorizontalAlignment="Right"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Spacing="8">
                                                <Button
                                                    x:Name="SkipBackwardButton"
                                                    Width="42"
                                                    Height="38"
                                                    Padding="0"
                                                    Click="SkipBackwardButton_Click"
                                                    ToolTipService.ToolTip="15 Sekunden zurück"
                                                    AutomationProperties.Name="15 Sekunden zurück">
                                                    <TextBlock
                                                        x:Name="SkipBackwardText"
                                                        Text="−15"
                                                        FontWeight="SemiBold" />
                                                </Button>
                                                <Button
                                                    Width="48"
                                                    Height="42"
                                                    Padding="0"
                                                    CornerRadius="21"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Click="PlayPauseButton_Click"
                                                    AutomationProperties.Name="Wiedergabe starten oder pausieren">
                                                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18" />
                                                </Button>
                                                <Button
                                                    x:Name="SkipForwardButton"
                                                    Width="42"
                                                    Height="38"
                                                    Padding="0"
                                                    Click="SkipForwardButton_Click"
                                                    ToolTipService.ToolTip="15 Sekunden vor"
                                                    AutomationProperties.Name="15 Sekunden vor">
                                                    <TextBlock
                                                        x:Name="SkipForwardText"
                                                        Text="+15"
                                                        FontWeight="SemiBold" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    Click="MuteButton_Click"
                                                    AutomationProperties.Name="Stummschalten">
                                                    <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="15" />
                                                </Button>
                                                <Slider
                                                    x:Name="VolumeSlider"
                                                    Width="110"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    Value="1"
                                                    StepFrequency="0.05"
                                                    ValueChanged="VolumeSlider_ValueChanged"
                                                    AutomationProperties.Name="Lautstärke" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="24"
                                    CornerRadius="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="9">
                                        <TextBlock Text="Transkript" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Für dieses Gespräch wurde noch kein Transkript erstellt. Die vollständig lokale Transkription folgt auf der Audio-Pipeline."
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConversationCountText" Text="0 Gespräche" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Opaque Discord-inspired floating update card. Keep all existing named controls/events. -->
        <Border
            x:Name="UpdateCard"
            Grid.RowSpan="2"
            Width="462"
            MaxWidth="462"
            Margin="16,16,24,24"
            Padding="20"
            CornerRadius="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#232428"
            BorderBrush="#484A53"
            BorderThickness="1"
            Visibility="Collapsed"
            AutomationProperties.Name="MeetingRecall Update-Benachrichtigung">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="#5865F2">
                        <FontIcon Glyph="&#xE895;" FontSize="20" Foreground="#FFFFFF" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="UpdateCardTitle"
                            Text="Update verfügbar"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#F2F3F5"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="MEETINGRECALL  ·  SOFTWARE-UPDATE"
                            FontSize="10"
                            CharacterSpacing="60"
                            Foreground="#B5BAC1" />
                    </StackPanel>
                    <Button
                        x:Name="UpdateCardCloseButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#35363C"
                        Foreground="#DBDEE1"
                        BorderBrush="#35363C"
                        Click="UpdateCardCloseButton_Click"
                        ToolTipService.ToolTip="Schließen"
                        AutomationProperties.Name="Update-Hinweis schließen">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                    </Button>
                </Grid>

                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="UpdateCardDescription"
                        TextWrapping="Wrap"
                        FontSize="13"
                        LineHeight="19"
                        Foreground="#DBDEE1" />
                    <TextBlock
                        x:Name="UpdateCardSizeLabel"
                        Margin="0,2,0,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Foreground="#B5BAC1"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    x:Name="UpdateDownloadPanel"
                    Spacing="8"
                    Visibility="Collapsed">
                    <ProgressBar
                        x:Name="UpdateDownloadProgressBar"
                        Height="7"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Foreground="#5865F2" />
                    <TextBlock
                        x:Name="UpdateDownloadProgressText"
                        Width="280"
                        HorizontalAlignment="Left"
                        TextAlignment="Left"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="#B5BAC1"
                        Text="0 %" />
                </StackPanel>

                <Grid
                    x:Name="UpdateCardActions"
                    ColumnSpacing="9"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.8*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="UpdateDeclineButton"
                        Grid.Column="0"
                        Height="38"
                        Padding="8,0"
                        HorizontalAlignment="Stretch"
                        FontSize="12"
                        Background="#35363C"
                        Foreground="#F2F3F5"
                        BorderBrush="#484A53"
                        Content="Ablehnen"
                        Click="UpdateDeclineButton_Click" />
                    <Button
                        x:Name="UpdateInstallButton"
                        Grid.Column="1"
                        Height="38"
                        Padding="8,0"
                        HorizontalAlignment="Stretch"
                        FontSize="12"
                        Content="Jetzt installieren"
                        Background="#5865F2"
                        Foreground="#FFFFFF"
                        BorderBrush="#5865F2"
                        FontWeight="SemiBold"
                        Click="UpdateInstallButton_Click" />
                </Grid>

                <Button
                    x:Name="UpdateCancelDownloadButton"
                    Content="Download abbrechen"
                    HorizontalAlignment="Right"
                    Background="#35363C"
                    Foreground="#F2F3F5"
                    BorderBrush="#484A53"
                    Visibility="Collapsed"
                    Click="UpdateCancelDownloadButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
